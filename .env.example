# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection used by Drizzle (direct connection, not the pooler, for migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 32 random bytes, base64. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Public pages: false says "Launching January" and collects sign-ups, true describes live payments
PAYMENTS_LIVE=false

# Payments: "mock" while building, "disabled" on a live site that is not taking payments yet
# (needs PAYMENTS_LIVE=false), "stitch" once the Stitch provider exists
PAYMENT_PROVIDER=mock
# mock only: success | decline | timeout | duplicate_webhook | late_webhook
MOCK_PAYMENT_SCENARIO=success
MOCK_WEBHOOK_SECRET=mock-webhook-secret

# Stitch (needed when PAYMENT_PROVIDER=stitch)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
